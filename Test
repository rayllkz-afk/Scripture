-- 2. Theme Configuration
local TacoGreen = Color3.fromRGB(55, 235, 120)
local TacoDarkGreen = Color3.fromRGB(12, 49, 27)

local function tacoColorize(object)
    if object:IsA("GuiObject") then
        local color = object.BackgroundColor3
        if color.R > 0.62 and color.G > 0.25 and color.G < 0.95 and color.B < 0.35 then
            object.BackgroundColor3 = TacoDarkGreen
        end
    end
    if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
        local color = object.TextColor3
        if color.R > 0.62 and color.G > 0.25 and color.G < 0.95 and color.B < 0.35 then
            object.TextColor3 = TacoGreen
        end
    elseif object:IsA("UIStroke") then
        local color = object.Color
        if color.R > 0.62 and color.G > 0.25 and color.G < 0.95 and color.B < 0.35 then
            object.Color = TacoGreen
        end
    elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
        local color = object.ImageColor3
        if color.R > 0.62 and color.G > 0.25 and color.G < 0.95 and color.B < 0.35 then
            object.ImageColor3 = TacoGreen
        end
    end
end

-- 3. Advanced Mobile UIScale & Styling Injection
local function applyTacoPreviewStyle()
    task.spawn(function()
        local gui
        for _ = 1, 25 do
            gui = getGui()
            if gui then break end
            task.wait(0.1)
        end
        if not gui then return end

        -- Automatic Mobile Detection & Proportional Scaling
        if UserInputService.TouchEnabled then
            local mobileScale = gui:FindFirstChild("TacoMobileScale")
            if not mobileScale then
                mobileScale = Instance.new("UIScale")
                mobileScale.Name = "TacoMobileScale"
                mobileScale.Scale = 0.65 -- Perfect balance for mobile screen widths
                mobileScale.Parent = gui
            end
        end

        for _, object in ipairs(gui:GetDescendants()) do tacoColorize(object) end
        gui.DescendantAdded:Connect(function(object)
            task.defer(function() if object and object.Parent then tacoColorize(object) end end)
        end)
    end)
end
applyTacoPreviewStyle()

