        local top = Instance.new("Frame")
        top.Size = UDim2.new(1, 0, 0, 4)
        top.BackgroundColor3 = AccentGreen
        top.BorderSizePixel = 0
        top.ZIndex = 100
        top.Parent = skin

        local gradient = Instance.new("UIGradient")
        gradient.Color = ColorSequence.new(Color3.fromRGB(20, 120, 62), AccentGreen)
        gradient.Parent = top

        local badge = Instance.new("TextLabel")
