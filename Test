local AccentGreen = Color3.fromRGB(55, 235, 120)
local DarkGreen = Color3.fromRGB(12, 49, 27)

local function themeColorize(object)
    if object:IsA("GuiObject") then
        local color = object.BackgroundColor3
        if color.R > 0.62 and color.G > 0.25 and color.G < 0.95 and color.B < 0.35 then
            object.BackgroundColor3 = DarkGreen
        end
    end
    if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
        local color = object.TextColor3
        if color.R > 0.62 and color.G > 0.25 and color.G < 0.95 and color.B < 0.35 then
            object.TextColor3 = AccentGreen
        end
    elseif object:IsA("UIStroke") then
        local color = object.Color
        if color.R > 0.62 and color.G > 0.25 and color.G < 0.95 and color.B < 0.35 then
            object.Color = AccentGreen
        end
    elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
        local color = object.ImageColor3
        if color.R > 0.62 and color.G > 0.25 and color.G < 0.95 and color.B < 0.35 then
            object.ImageColor3 = AccentGreen
        end
    end
end

local function applyReapStyle()
    task.spawn(function()
        local gui
        for _ = 1, 25 do
            gui = PlayerGui:FindFirstChild("Reap6a6yGui")
            if gui then break end
            task.wait(0.1)
        end
        if not gui then return end

        if UserInputService.TouchEnabled then
            local mobileScale = gui:FindFirstChild("ReapMobileScale")
            if not mobileScale then
                mobileScale = Instance.new("UIScale")
                mobileScale.Name = "ReapMobileScale"
                mobileScale.Scale = 0.65
                mobileScale.Parent = gui
            end
        end

        for _, object in ipairs(gui:GetDescendants()) do
            themeColorize(object)
        end
        gui.DescendantAdded:Connect(function(object)
            task.defer(function()
                if object and object.Parent then themeColorize(object) end
            end)
        end)

        local old = gui:FindFirstChild("ReapPreviewSkin")
        if old then old:Destroy() end

        local skin = Instance.new("Frame")
        skin.Name = "ReapPreviewSkin"
        skin.BackgroundTransparency = 1
        skin.Active = false
        skin.Selectable = false
        skin.Size = UDim2.fromScale(1, 1)
        skin.ZIndex = 100
