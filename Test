-- Helper to create styled buttons
local function createButton(name, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = DarkGreen
    btn.Text = name
    btn.TextColor3 = AccentGreen
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Parent = scrollFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = AccentGreen
    stroke.Transparency = 0.4
    stroke.Parent = btn

    btn.MouseButton1Click:Connect(callback)
end

-- Helper to create toggle buttons
local function createToggle(name, getState, setStateCallback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = DarkGreen
    btn.TextColor3 = AccentGreen
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Parent = scrollFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = AccentGreen
    stroke.Transparency = 0.4
    stroke.Parent = btn

    local function updateText()
        btn.Text = name .. ": " .. (getState() and "[ON]" or "[OFF]")
    end
    updateText()

    btn.MouseButton1Click:Connect(function()
        local newState = not getState()
        setStateCallback(newState)
        updateText()
    end)
end

