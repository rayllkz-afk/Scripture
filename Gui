    function Group:AddButton(textOrData, callback)
        local data = type(textOrData) == "table" and textOrData or { Text = textOrData, Func = callback }
        local title = data.Text or data.Name or data.Title or "Button"
        local action = data.Func or data.Callback or callback
        self.Raw:CreateButton({
            Name = tostring(title),
            Callback = function() safe(action) end,
        })
        return self
    end

    function Group:AddToggle(flag, data)
        if type(flag) == "table" then data, flag = flag, nil end
        data = data or {}
        local default = data.Default == true or data.Value == true
        local control = makeControl(flag or data.Flag, default, data.Callback or data.callback, true)
        self.Raw:CreateToggle({
            Name = data.Text or data.Name or tostring(flag),
            CurrentValue = default,
            Flag = tostring(flag or control.Flag),
            Callback = function(value) control:_fire(value == true) end,
        })
        control._building = false
        return control
    end

    function Group:AddSlider(flag, data)
        if type(flag) == "table" then data, flag = flag, nil end
        data = data or {}
        local default = data.Default
        if default == nil then default = data.Min or 0 end
        local control = makeControl(flag or data.Flag, default, data.Callback or data.callback, false)
        self.Raw:CreateSlider({
            Name = data.Text or data.Name or tostring(flag),
            Range = { tonumber(data.Min) or 0, tonumber(data.Max) or 100 },
            Increment = data.Step or (data.Rounding and (1 / (10 ^ data.Rounding))) or 1,
            Suffix = data.Suffix or "",
            CurrentValue = default,
            Flag = tostring(flag or control.Flag),
            Callback = function(value) control:_fire(value) end,
        })
        control._building = false
        return control
    end

    function Group:AddDropdown(flag, data)
        if type(flag) == "table" then data, flag = flag, nil end
        data = data or {}
        local values = data.Values or data.Items or {}
        local default = data.Default or data.Value or values[1]
        local control = makeControl(flag or data.Flag, default, data.Callback or data.callback, false)
        control.Values = values
        self.Raw:CreateDropdown({
            Name = data.Text or data.Name or tostring(flag),
            Options = values,
            CurrentOption = default,
            Flag = tostring(flag or control.Flag),
            Callback = function(value) control:_fire(value) end,
