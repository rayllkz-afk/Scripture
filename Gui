        label.Font = Enum.Font.GothamMedium
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.Parent = section.Inner
        return label
    end

    local function parseKey(value)
        if typeof(value) == "EnumItem" then return value end
        local key = tostring(value or "RightShift"):gsub("Enum%.KeyCode%.", "")
        return Enum.KeyCode[key] or Enum.KeyCode.RightShift
    end

    local Group = {}
    Group.__index = Group

    function Group:AddLabel(text)
        local visual = customLabel(self.Raw, text)
        local label = { _visual = visual, _group = self }
        function label:SetText(value)
            if self._visual then self._visual.Text = tostring(value or "") end
            return self
        end
        function label:AddColorPicker(flag, data)
            data = data or {}
            local default = data.Default or Color3.fromRGB(255, 255, 255)
            local control = makeControl(flag, default, data.Callback or data.callback, false)
            self._group.Raw:CreateColorPicker({
                Name = data.Title or data.Text or "Color",
                Color = default,
                Flag = tostring(flag),
                Callback = function(value) control:_fire(value) end,
            })
            control._building = false
            return control
        end
        function label:AddKeyPicker(flag, data)
            data = data or {}
            local default = parseKey(data.Default or "RightShift")
            local control = makeControl(flag, default.Name, data.Callback or data.callback, false)
            customLabel(self._group.Raw, "Keybind: " .. default.Name)
            local connection = UserInputService.InputBegan:Connect(function(input, processed)
                if processed or Library._unloaded then return end
                if input.KeyCode == parseKey(control.Value) then
                    Library.Toggle()
                end
            end)
            function control:SetValue(value)
                local key = parseKey(value)
                self:_fire(key.Name)
                return self
            end
            control._building = false
            Library:OnUnload(function() if connection then connection:Disconnect() end end)
            return control
        end
        return label
    end

    function Group:AddDivider()
        local line = Instance.new("Frame")
