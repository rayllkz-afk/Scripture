                control:_fire(value)
            end,
        })
        control._building = false
        return control
    end

    local function newGroup(section)
        return setmetatable({ Raw = section }, Group)
    end

    local function newTab(rawTab)
        local tab = { Raw = rawTab }
        local function section(name, side)
            if rawTab._colToggle ~= nil then
                if side == 1 then
                    rawTab._colToggle = false
                else
                    rawTab._colToggle = true
                end
            end
            return newGroup(rawTab:CreateSection(tostring(name or "Group")))
        end
        function tab:AddLeftGroupbox(name) return section(name, 1) end
        function tab:AddRightGroupbox(name) return section(name, 2) end
        function tab:AddLeftTabbox(name)
            local box = { _name = tostring(name or "Extra"), _tab = tab, _index = 0 }
            function box:AddTab(tabName)
                self._index = self._index + 1
                return self._tab:AddLeftGroupbox(self._name .. " • " .. tostring(tabName or self._index))
            end
            return box
        end
        function tab:AddRightTabbox(name)
            local box = { _name = tostring(name or "Extra"), _tab = tab, _index = 0 }
            function box:AddTab(tabName)
                self._index = self._index + 1
                return self._tab:AddRightGroupbox(self._name .. " • " .. tostring(tabName or self._index))
            end
            return box
        end
        return tab
    end

